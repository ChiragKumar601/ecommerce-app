{
  "name": "@app/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "start:worker": "node --env-file-if-exists=.env dist/worker.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force && prisma generate",
    "db:seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts",
    "postinstall": "prisma generate",
    "pretest": "prisma generate",
    "pretypecheck": "prisma generate",
    "images:fetch": "tsx --env-file-if-exists=.env src/scripts/fetch-images.ts",
    "catalogue:generate": "tsx src/scripts/catalogue-stats.ts",
    "config:sync": "tsx --env-file-if-exists=.env src/scripts/config-sync.ts",
    "seed:verify": "tsx --env-file-if-exists=.env src/scripts/verify-seed.ts",
    "images:refresh": "tsx --env-file-if-exists=.env src/scripts/refresh-images.ts"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-libsql": "7.10.0",
    "@prisma/client": "7.10.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/supertest": "^7.2.1",
    "prisma": "7.10.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
