// Database schema (plan §6). SQLite via the libSQL driver adapter.
// Tables are added migration by migration, following plan §6.2 (M1 arrives in Stage 3).
// Constraints Prisma can't express (CHECKs, partial unique indexes) live in hand-written
// migration SQL (plan §6.1).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ───────────────────────── M1: config, content, reference (plan §6.2) ─────────────────────────

/// Key/value settings from spec §5, incl. `catalogue_version` (plan §7.4).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model HeroSlide {
  id          String  @id
  imageUrl    String
  imageAlt    String
  headline    String
  subheadline String?
  ctaLabel    String
  href        String
  order       Int
  active      Boolean @default(true)
}

model ShopByCategoryCard {
  id           String  @id
  name         String
  imageUrl     String
  imageAlt     String
  discountText String
  href         String
  order        Int
  active       Boolean @default(true)
}

model PopularSearch {
  term  String @id
  order Int
}

model ContentPage {
  slug          String  @id
  title         String
  body          String
  isPlaceholder Boolean @default(true)
}

model FaqEntry {
  id       String @id
  topic    String
  question String
  answer   String
  order    Int
}

model SecurityQuestion {
  id     String  @id
  text   String
  order  Int
  active Boolean @default(true)
}

model StateRef {
  code String @id
  name String @unique
  type String // 'state' | 'ut'
}

model DeliveryZone {
  zone         String               @id // 'A' | 'B' | 'C'
  deliveryDays Int
  pincodes     ServiceablePincode[]
}

model ServiceablePincode {
  pincode String       @id
  city    String
  state   String
  zone    String
  zoneRef DeliveryZone @relation(fields: [zone], references: [zone])

  @@index([zone])
}

/// Tax rate per catalogue node; the most specific node wins (R-35).
model TaxRate {
  nodeId      String        @id
  node        CatalogueNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  ratePercent Int
}

/// Non-returnable catalogue nodes (R-17); a product is returnable unless any of its nodes is listed.
model ReturnPolicyNode {
  nodeId String        @id
  node   CatalogueNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
}

model Coupon {
  code             String   @id // stored upper-case
  description      String
  type             String // 'percent' | 'flat'
  value            Int
  maxDiscount      Int?
  minEligibleValue Int
  eligibleNodeIds  Json // string[]; empty = all
  validFrom        DateTime
  validTo          DateTime
  perCustomerLimit Int
  active           Boolean  @default(true)
}

model BankOffer {
  id               String   @id
  bankName         String
  cardTypes        Json // ('credit' | 'debit')[]
  percent          Int
  maxDiscount      Int
  minEligibleValue Int
  validFrom        DateTime
  validTo          DateTime
  summary          String
  termsText        String
  active           Boolean  @default(true)
}

/// Designated demo test cards (DAT-006). Public test numbers, published on /demo-help.
model TestCard {
  number        String  @id
  last4         String
  network       String
  issuingBank   String
  cardType      String // 'credit' | 'debit'
  forcedOutcome String? // null = random outcome
  label         String
}

model TestUpi {
  upiId         String @id
  forcedOutcome String
}

model GiftCardCode {
  code         String  @id // stored upper-case
  faceValue    Int
  validityDays Int
  active       Boolean @default(true)
}

model BlockedWord {
  word String @id
}

// ───────────────────────── M2: catalogue (plan §6.2, spec §4.1) ─────────────────────────

model CatalogueNode {
  id           String            @id
  type         String // 'section' | 'category' | 'subcategory'
  name         String
  slug         String
  /// Full path of slugs, e.g. `men/topwear/t-shirts`. Unique.
  path         String            @unique
  parentId     String?
  parent       CatalogueNode?    @relation("NodeTree", fields: [parentId], references: [id])
  children     CatalogueNode[]   @relation("NodeTree")
  displayOrder Int
  active       Boolean           @default(true)
  products     ProductNode[]
  taxRate      TaxRate?
  returnPolicy ReturnPolicyNode?

  @@unique([parentId, slug])
  @@index([type])
}

model Brand {
  id       String    @id
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model SizeGuide {
  id       String    @id
  name     String
  table    Json // { columns: string[]; rows: string[][] }
  notes    String
  products Product[]
}

model Product {
  id                String              @id // short random id (public)
  slug              String
  brandId           String
  brand             Brand               @relation(fields: [brandId], references: [id])
  name              String
  subtitle          String
  description       String
  materialCare      String
  specifications    Json // { key: string; value: string }[]
  primarySectionId  String
  primaryNodeId     String
  gender            String
  colour            String
  /// Products of the same style in other colours share this id ("More colours", PDP-003).
  styleGroupId      String
  listingDate       DateTime
  bestSeller        Boolean             @default(false)
  bankOfferEligible Boolean             @default(false)
  returnable        Boolean             @default(true)
  inclusiveSizing   Boolean             @default(false)
  sizeGuideId       String?
  sizeGuide         SizeGuide?          @relation(fields: [sizeGuideId], references: [id])
  active            Boolean             @default(true)
  nodes             ProductNode[]
  variants          Variant[]
  images            ProductImage[]
  curatedRecs       ProductCuratedRec[] @relation("RecSource")
  curatedIn         ProductCuratedRec[] @relation("RecTarget")
  reviews           Review[]
  ratingAggregate   RatingAggregate?
  wishlistEntries   WishlistEntry[]

  @@index([active, listingDate])
  @@index([styleGroupId])
  @@index([brandId])
}

model ProductNode {
  productId String
  nodeId    String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  node      CatalogueNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([productId, nodeId])
  @@index([nodeId])
}

model Variant {
  id           String     @id
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizeLabel    String
  sortOrder    Int
  mrp          Int
  sellingPrice Int
  active       Boolean    @default(true)
  inventory    Inventory?
  bagLines     BagLine[]

  @@index([productId])
}

/// available = onHand − held, never below 0 (CHECK added in hand-written SQL).
model Inventory {
  variantId      String  @id
  variant        Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  onHand         Int
  held           Int     @default(0)
  baselineOnHand Int
}

/// Every image records its source and licence (D-22).
model ProductImage {
  id              String  @id
  productId       String
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url             String
  alt             String
  order           Int
  source          String // 'pexels'
  sourcePageUrl   String
  photographer    String
  photographerUrl String?
  licence         String

  @@index([productId])
}

model ProductCuratedRec {
  productId String
  kind      String // 'bought_together' | 'complete_the_look'
  targetId  String
  order     Int
  product   Product @relation("RecSource", fields: [productId], references: [id], onDelete: Cascade)
  target    Product @relation("RecTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([productId, kind, targetId])
}

// ───────────────────────── M3: reviews, read side (spec §4.2) ─────────────────────────

model Review {
  id                String         @id
  productId         String
  product           Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Null for seeded reviews and after an account is purged (PRV-003). FK added with accounts (M4).
  authorAccountId   String?
  author            Account?       @relation(fields: [authorAccountId], references: [id], onDelete: SetNull)
  authorDisplayName String
  rating            Int
  text              String?
  verifiedPurchase  Boolean        @default(false)
  status            String         @default("visible") // 'visible' | 'hidden'
  seeded            Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  images            ReviewImage[]
  reports           ReviewReport[]

  /// One review per account and product (REV-006). SQLite treats NULLs as distinct.
  @@unique([authorAccountId, productId])
  @@index([productId, status, createdAt])
}

model ReviewImage {
  id       String @id
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  url      String
  order    Int
}

model ReviewReport {
  reviewId          String
  reporterAccountId String
  createdAt         DateTime @default(now())
  review            Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([reviewId, reporterAccountId])
}

/// Derived cache of visible reviews (PR-29); recomputed in the same transaction as review changes.
model RatingAggregate {
  productId  String  @id
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  count      Int
  sumRatings Int
  c1         Int
  c2         Int
  c3         Int
  c4         Int
  c5         Int
}

// ───────────────────────── Platform (Stage 4) ─────────────────────────

/// Fixed-window rate-limit counters, shared across processes (SEC-004).
model RateLimitBucket {
  key         String   @id // `<group>:<client>:<windowStart>`
  windowStart DateTime
  count       Int

  @@index([windowStart])
}

// ───────────────────────── M4 accounts (Stage 10) ─────────────────────────

/// Customer account (spec §4.3). At least one of email/phone (CHECK in SQL); each unique when set (R-08).
model Account {
  id                          String              @id
  name                        String
  email                       String?             @unique
  phone                       String?             @unique
  passwordHash                String
  securityQuestionId          String
  securityAnswerHash          String
  gender                      String?
  dateOfBirth                 String? // YYYY-MM-DD
  ageConfirmedAt              DateTime
  createdAt                   DateTime            @default(now())
  failedLoginCount            Int                 @default(0)
  lockedUntil                 DateTime?
  failedResetCount            Int                 @default(0)
  resetLockedUntil            DateTime?
  passwordChangedAt           DateTime?
  passwordChangeNoticePending Boolean             @default(false)
  /// Last login or authenticated activity (PRV-001 inactivity purge).
  lastActivityAt              DateTime            @default(now())
  sessions                    Session[]
  recentSearches              RecentSearch[]
  creditEntries               CreditLedgerEntry[]
  resetTokens                 PasswordResetToken[]
  reviews                     Review[]
  bag                         Bag?
  bagLines                    BagLine[]
  wishlist                    WishlistEntry[]
  savedCards                  SavedCard[]
  giftCards                   AccountGiftCard[]
  supportRequests             SupportRequest[]
  addresses                   Address[]
  checkouts                   CheckoutSession[]
  orders                      Order[]
  deletionRequestedAt         DateTime?
}

/// Server-side session; the cookie carries a random token, the table stores its SHA-256 (SEC-001).
model Session {
  id             String    @id // sha256(token)
  accountId      String
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  lastActivityAt DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?

  @@index([accountId])
}

/// Single-use token issued after a correct security answer (AUTH-009), stored hashed.
model PasswordResetToken {
  id        String    @id // sha256(token)
  accountId String
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
}

/// Failure counters for identifiers with no account, keyed by purpose + client (+ identifier), so
/// lockout responses look the same whether or not an account exists (AUTH-006, AUTH-009, SD-38).
model AuthThrottle {
  key         String    @id
  failures    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

/// Account recent searches (SRC-009, ≤ 10, case-insensitive unique).
model RecentSearch {
  id         String   @id
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  term       String
  termLower  String
  searchedAt DateTime

  @@unique([accountId, termLower])
  @@index([accountId, searchedAt])
}

/// Stored responses for repeated idempotency keys (API-003). Cleaned up after 24 h.
model IdempotencyKey {
  key          String   @id // accountId:route:clientKey
  requestHash  String
  status       Int
  responseBody String
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

/// Credits ledger (spec §4.4): balance = sum of amounts; credits don't expire (SD-11).
model CreditLedgerEntry {
  id        String   @id
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amount    Int // paise, + or −
  type      String // 'signup_grant' | 'order_debit' | 'order_debit_reversal' | 'refund_credit'
  orderId   String?
  refundId  String?
  note      String
  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
}

// ───────────────────────── M5 bag & wishlist (Stage 11) ─────────────────────────

/// A customer's bag (spec §4.5); guest bags live on the device. Survives indefinitely (BAG-013).
model Bag {
  accountId  String   @id
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  couponCode String?
  updatedAt  DateTime @updatedAt
}

/// Unique per variant within a bag; quantity 1–10 (CHECK in SQL); at most 50 lines (service rule).
model BagLine {
  accountId         String
  account           Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  variantId         String
  variant           Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity          Int
  addedAt           DateTime
  /// Unit price the customer last saw, for "Price changed from ₹X to ₹Y" (BAG-004).
  lastSeenUnitPrice Int

  @@id([accountId, variantId])
}

/// Wishlist entry: a product, not a size; unique per product (T-26).
model WishlistEntry {
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  addedAt   DateTime

  @@id([accountId, productId])
  @@index([accountId, addedAt])
}

// ───────────────────────── M6 profile & wallet (Stage 12) ─────────────────────────

/// Masked card only: never the full number or CVV (SEC-003). At most 5 per account; one default.
model SavedCard {
  id          String   @id
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  nameOnCard  String
  last4       String
  network     String
  issuingBank String
  cardType    String // 'credit' | 'debit'
  expiryMonth Int
  expiryYear  Int
  isDefault   Boolean  @default(false)
  /// SHA-256 of the designated test card number, so the simulator can find its forced outcome.
  testCardRef String
  createdAt   DateTime

  @@index([accountId, createdAt])
}

/// A demo gift card redeemed by an account (spec §4.4, §7.6). Unique per (account, code).
model AccountGiftCard {
  id             String          @id
  accountId      String
  account        Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  code           String
  initialBalance Int
  balance        Int
  redeemedAt     DateTime
  expiresAt      DateTime
  status         String // 'active' | 'exhausted' | 'expired'
  transactions   GiftCardTxn[]

  @@unique([accountId, code])
}

model GiftCardTxn {
  id                String          @id
  accountGiftCardId String
  giftCard          AccountGiftCard @relation(fields: [accountGiftCardId], references: [id], onDelete: Cascade)
  amount            Int // paise, + or −
  type              String // 'redeem' | 'order_debit' | 'order_debit_reversal' | 'refund_credit'
  orderId           String?
  createdAt         DateTime

  @@index([accountGiftCardId, createdAt])
}

/// Contact Us requests (PRF-006, T-37). `account_deletion` leads to a purge at the next daily run (PRV-002).
model SupportRequest {
  id            String   @id
  requestNumber String   @unique
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type          String
  orderId       String?
  message       String
  status        String   @default("submitted")
  createdAt     DateTime

  @@index([accountId, createdAt])
}

// ───────────────────────── M7 addresses (Stage 13) ─────────────────────────

/// Saved address (spec §4.4, ADDR-*). At most 10 per account; exactly one default if any exist.
/// `serviceable` is derived from the pincode list when saved and re-checked when used.
model Address {
  id             String   @id
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  recipientName  String
  recipientPhone String
  houseFlat      String
  building       String?
  streetArea     String
  landmark       String?
  city           String
  state          String
  pincode        String
  labelType      String // 'Home' | 'Work' | 'Other'
  labelText      String?
  latitude       Float?
  longitude      Float?
  isDefault      Boolean  @default(false)
  createdAt      DateTime
  updatedAt      DateTime @updatedAt

  @@index([accountId, createdAt])
}

// ───────────────────────── M8 checkout & quotes (Stage 14) ─────────────────────────

/// The current checkout attempt, kept on the server so it survives a session expiry (CHK-007).
model CheckoutSession {
  id                   String   @id
  accountId            String
  account              Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  source               String // 'bag' | 'buy_now'
  /// [{ variantId, quantity }] — the bag's lines at checkout start, or the Buy Now item.
  lines                Json
  couponCode           String?
  addressId            String?
  /// Phone used for this order only, when it belongs to another account (CHK-003, EC-14).
  contactPhone         String?
  step                 String   @default("address") // 'address' | 'summary' | 'payment'
  /// Re-validation changes the customer must acknowledge before paying (CHK-002).
  pendingChanges       Json?
  /// Gift card, credits, method, card (S15).
  paymentSelection     Json?
  createdAt            DateTime
  updatedAt            DateTime @updatedAt
  expiresAt            DateTime

  @@index([accountId, createdAt])
}

/// Quotes shown at checkout and payment (API-006, PR-25). Pay sends the quoteId it showed.
model Quote {
  id         String   @id
  accountId  String
  checkoutId String?
  orderId    String?
  /// The engine's output plus the inputs Pay needs to compare (prices, coupon, wallet, method).
  payload    Json
  createdAt  DateTime

  @@index([createdAt])
}

// ───────────────────────── M9 orders & payment (Stage 15) ─────────────────────────

/// An order (spec §4.7). Prices are locked at Pay (D-39). `version` is bumped first in every write
/// transaction on the order, which serialises customer actions and scheduler transitions (API-008).
model Order {
  id                   String               @id
  orderNumber          String               @unique
  accountId            String
  account              Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  status               String
  version              Int                  @default(0)
  source               String // 'bag' | 'buy_now'
  createdAt            DateTime
  placedAt             DateTime?
  deliveredAt          DateTime?
  /// End of the 15-minute retry window (PAY-012).
  retryEndsAt          DateTime
  addressSnapshot      Json
  contactPhone         String
  /// The full quote at Pay, with the coupon and bank-offer state.
  priceSnapshot        Json
  couponCode           String?
  bankOfferApplied     Boolean              @default(false)
  total                Int
  deliveryCharge       Int
  zone                 String
  expectedDeliveryDate String // YYYY-MM-DD (ORD-005)
  deliveryOtp          String?
  deliveryAttempt      Int                  @default(0)
  otpFailures          Int                  @default(0)
  courierName          String?
  trackingId           String?
  /// Next scheduled automatic transition (order steps, handover window end) (S16).
  nextTransitionAt     DateTime?
  hasUnseenUpdate      Boolean              @default(false)
  lines                OrderLine[]
  attempts             PaymentAttempt[]
  allocations          PaymentAllocation[]
  events               OrderStatusEvent[]

  @@index([accountId, createdAt])
  @@index([status, retryEndsAt])
  @@index([status, nextTransitionAt])
}

model OrderLine {
  id                 String    @id
  orderId            String
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId          String
  productId          String
  /// name, brand, size, image, href at Pay.
  productSnapshot    Json
  quantity           Int
  unitMrp            Int
  unitSellingPrice   Int
  couponShare        Int
  bankOfferShare     Int
  lineNetPaid        Int
  taxRatePercent     Int
  taxPortion         Int
  lineState          String    @default("active") // 'active' | 'cancelled'
  returnable         Boolean
  returnWindowEndsAt DateTime?
  position           Int

  @@index([orderId])
}

/// One payment try. At most one `pending` per order (partial unique index). All four outcomes are final.
model PaymentAttempt {
  id               String    @id
  orderId          String
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method           String // 'card' | 'upi' | 'cod' | 'none'
  /// "Visa •••• 0009" or the UPI ID; never a full card number (SEC-003).
  instrumentLabel  String?
  testCardRef      String?
  upiId            String?
  amount           Int
  outcome          String // 'pending' | 'success' | 'failure' | 'cancelled' | 'timed_out'
  /// The outcome decided at Pay (forced by a test value, or weighted random); revealed at resolveAt.
  decidedOutcome   String
  forcedByTestValue Boolean  @default(false)
  /// Card to save once the attempt is final (PAY-014): masked fields only.
  saveCard         Json?
  bankOfferDiscount Int      @default(0)
  createdAt        DateTime
  resolveAt        DateTime
  resolvedAt       DateTime?

  @@index([outcome, resolveAt])
  @@index([orderId])
}

model PaymentAllocation {
  id                String   @id
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  source            String // 'card' | 'upi' | 'cod' | 'gift_card' | 'credits'
  amount            Int
  accountGiftCardId String?
  /// card / UPI label for refunds and the payment breakdown.
  label             String?
  status            String // 'reserved' | 'captured' | 'released' | 'cod_due' | 'cod_collected'
  createdAt         DateTime

  @@index([orderId])
}

model OrderStatusEvent {
  id         String   @id
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  at         DateTime
  actor      String // 'customer' | 'scheduler' | 'delivery_simulator' | 'system'
  note       String?

  @@index([orderId, at])
}
